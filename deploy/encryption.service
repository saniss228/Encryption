[Unit]
Description=Encryption Messenger Server (FastAPI + WebSocket)
Documentation=file:///opt/encryption/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=encryption
Group=encryption
WorkingDirectory=/opt/encryption

# ── Переменные окружения ──────────────────────────────────────────────────
Environment=ENC_HOST=0.0.0.0
Environment=ENC_PORT=6000
Environment=ENC_PUBLIC_IP=45.90.45.92
Environment=ENC_DATA_DIR=/opt/encryption/data
Environment=ENC_WEB_DIR=/opt/encryption/web
# Логины администраторов (через запятую). Панель: Настройки → Админ-панель
Environment=ENC_ADMINS=saniss

# Когда получите TLS-сертификат — раскомментируйте (uvicorn сам поднимет HTTPS):
# Environment=ENC_TLS_CERT=/etc/letsencrypt/live/your-domain.ru/fullchain.pem
# Environment=ENC_TLS_KEY=/etc/letsencrypt/live/your-domain.ru/privkey.pem

ExecStart=/opt/encryption/.venv/bin/python -m server.app
Restart=always
RestartSec=3
KillSignal=SIGINT

# ── Ужесточение прав ──────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/encryption/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

# ── Логи ──────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=encryption

[Install]
WantedBy=multi-user.target
